# Copy using scripts/setup.ps1. Never commit the generated .env.
ATTENDANCE_ENVIRONMENT=development
ATTENDANCE_DATABASE=.local/attendance.db
ATTENDANCE_SECURE_COOKIES=false
ATTENDANCE_ORIGINS=http://127.0.0.1:7357,http://127.0.0.1:8000,https://localhost:8443
ATTENDANCE_REPORT_KEY=GENERATE_A_BASE64_ENCODED_32_BYTE_KEY
ATTENDANCE_KEY_VERSION=v1
# Supply locally; minimum 12 characters. No default login password.
DEMO_ADMIN_PASSWORD=
DEMO_TEACHER_PASSWORD=
DEMO_SUPERVISOR_PASSWORD=
